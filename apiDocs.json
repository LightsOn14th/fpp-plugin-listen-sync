{
    "paths": {
        "/ListenSync/status": {
            "get": {
                "summary": "Listen Sync connection, clock, playback and upload status",
                "responses": { "200": { "description": "Status object" } }
            }
        },
        "/ListenSync/token": {
            "post": {
                "summary": "Save the relay token (plain text body) and reconnect",
                "responses": { "200": { "description": "Status object" }, "400": { "description": "Token could not be saved" } }
            }
        },
        "/ListenSync/upload": {
            "post": {
                "summary": "Start a media upload check now",
                "responses": { "200": { "description": "Status object" } }
            }
        }
    }
}
